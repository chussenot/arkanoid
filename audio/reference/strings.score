# Reference render: the string sections (Phase 2 ear check, not music).
# Sustains swelling across the sections, a spiccato ostinato, a tremolo
# crescendo, pizzicato. E minor; 72 BPM.
score 1
title Reference: strings
tempo 0 72
length 32
tail 4
seed 1
include ../instruments/desk.inc
include ../instruments/orchestra.inc
include ../instruments/electronic.inc

# Sustains: an E minor chord across the sections, swelling in and out.
note 0 7.5 strings_bass E2 100
note 0 7.5 strings_low B2 100
note 0 7.5 strings_low E3 100
note 0 7.5 strings_mid G3 100
note 0 7.5 strings_mid B3 100
note 0 7.5 strings_high E4 100
note 0 7.5 strings_high G4 100
note 0 7.5 strings_high B4 100
ramp strings_high.gain 0 3 -18 0 smooth
ramp strings_mid.gain 0 3 -18 0 smooth
ramp strings_low.gain 0 3 -18 0 smooth
ramp strings_bass.gain 0 3 -18 0 smooth
ramp strings_high.gain 5 7.5 0 -14 smooth
ramp strings_mid.gain 5 7.5 0 -14 smooth
ramp strings_low.gain 5 7.5 0 -14 smooth
ramp strings_bass.gain 5 7.5 0 -14 smooth

# Spiccato: an eighth-note ostinato, low strings on the root, violins on the arpeggio.
note 8.0 0.4 strings_high_spic E4 112
