# Reference render: the brass (Phase 2 ear check, not music). A horn line
# over low brass, a full-section swell, staccato stabs. E minor; 80 BPM.
score 1
title Reference: brass
tempo 0 80
length 32
tail 4
seed 1
include ../instruments/desk.inc
include ../instruments/orchestra.inc
include ../instruments/electronic.inc

# Horns: a slow stepwise line over low brass chords.
