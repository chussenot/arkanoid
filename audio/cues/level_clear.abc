X:1
T:level_clear
C:BRYX
M:4/4
L:1/16
Q:1/4=160
K:C
% Spark bounding up, then the E minor triad climbing to a held high E.
%%hold on
%%master 86.0
%%bandlimit on
%%instrument brass wave=pulse amp=27 duty=28 attack=6 decay=120 sustain=70 release=280 gate=88 vibrato=6 fx=0
%%instrument harm wave=pulse amp=18 duty=40 attack=6 decay=120 sustain=60 release=280 gate=88 fx=0
%%instrument bass wave=triangle amp=30 attack=2 decay=160 sustain=60 release=280 gate=90 fx=0
%%effect 0 delay_steps=3 delay_feedback=34 delay_mix=26 drive=0 lowpass=10 reverb=12 reverb_size=55 reverb_damp=45 mix=100
V:brass instrument=brass
| !mf!B z d e z g2 z a g e z d2 z2 | !f!e2 g2 b2 !ff!e'10 |
V:harm instrument=harm
| z16 | !f!B2 e2 g2 !ff![gb]10 |
V:bass instrument=bass
| E,4 E,4 G,4 G,4 | C,4 D,4 E,8 |
