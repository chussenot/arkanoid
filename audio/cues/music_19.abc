% Regal: Ascent as a fanfare in harmonic minor, then crowned an octave higher.
% mode E harmonic, progression heroic, form intro(2) A(4) B(4) break(2) A2(4)
% A=ascent B=ascent_hi counter=spark
%%hold on
%%master 34.1
%%instrument kick wave=triangle amp=67 attack=0 decay=70 sustain=0 release=40 gate=60 pitch=24 pitch_time=55 fx=0
