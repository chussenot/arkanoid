X:1
T:brick
C:BRYX
M:4/4
L:1/16
Q:1/4=240
K:C
% A pulse pop that snaps down onto its note, with a glint of metal on top.
% The director pitches it up the scale by playback rate, so it stays on E.
%%hold on
%%master 103.2
%%bandlimit on
%%instrument pop wave=pulse amp=88 duty=22 attack=0 decay=90 sustain=0 release=90 gate=90 pitch=7 pitch_time=14 fx=0
%%instrument glint wave=noise amp=12 attack=0 decay=18 sustain=0 release=14 gate=30 noise=metal fx=0
%%effect 0 delay_steps=0 delay_feedback=0 delay_mix=0 drive=10 lowpass=12 mix=100
V:pop instrument=pop
| e z7 |
V:glint instrument=glint
| e'' z7 |
