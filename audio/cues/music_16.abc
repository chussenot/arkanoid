X:1
T:BRYX 16 Bridges
C:BRYX (audio/compose.py)
M:4/4
L:1/16
Q:1/4=122
K:C
% Ascent stretched across the Wall like a viaduct; harmonic minor's D sharp lifts the span.
% mode E harmonic, progression heroic, form A(4) B(4) break(2) A2(4) turn(2)
% A=ascent_aug B=spark counter=wall_hi
%%hold on
%%master 47.8
%%loop on
%%bandlimit on
%%instrument kick wave=triangle amp=67 attack=0 decay=70 sustain=0 release=40 gate=60 pitch=24 pitch_time=55 fx=0
%%instrument snare wave=noise amp=22 attack=0 decay=60 sustain=0 release=70 gate=50 noise=long pitch=12 pitch_time=40 accents=marked fx=0
%%instrument hat wave=noise amp=10 attack=0 decay=12 sustain=0 release=14 gate=20 noise=metal accents=marked fx=0
%%instrument tom wave=triangle amp=40 attack=0 decay=140 sustain=0 release=60 gate=80 pitch=7 pitch_time=70 accents=marked fx=0
%%instrument bass wave=triangle amp=58 attack=1 decay=80 sustain=70 release=90 gate=84 fx=0
%%instrument arp wave=pulse amp=29 duty=8 attack=0 decay=40 sustain=30 release=90 gate=40 fx=2
%%instrument pad wave=pulse amp=15 duty=46 stack=2 detune=7 attack=200 decay=240 sustain=84 release=420 gate=98 accents=marked fx=1
%%instrument lead wave=triangle amp=36 attack=10 decay=140 sustain=76 release=260 gate=90 vibrato=9 vibrato_delay=200 glide=14 accents=marked fx=1
%%instrument counter wave=pulse amp=15 duty=30 attack=6 decay=120 sustain=66 release=220 gate=84 accents=marked fx=1
%%effect 0 delay_steps=0 delay_feedback=0 delay_mix=0 drive=8 lowpass=30 mix=100
%%effect 1 delay_steps=3 delay_feedback=48 delay_mix=38 drive=0 lowpass=46 reverb=18 reverb_size=85 reverb_damp=45 mix=80
%%effect 2 mode=insert delay_steps=4 delay_feedback=40 delay_mix=34 drive=0 lowpass=50 sidechain=40 sidechain_release=220 sidechain_key=kick mix=100
%%effect 3 delay_steps=6 delay_feedback=30 delay_mix=30 drive=0 lowpass=60 mix=70
%%ramp bus1 delay_mix 38 38 0 0
%%ramp bus1 reverb 18 18 0 0
%%ramp bus1 delay_mix 38 60 128 159
%%ramp bus1 delay_mix 38 38 160 160
%%ramp bus1 delay_mix 62 62 224 224
%%ramp bus1 delay_mix 38 38 240 240
%%ramp bus1 reverb 18 45 128 159
%%ramp bus1 reverb 18 18 160 160
