X:1
T:armor
C:BRYX
M:4/4
L:1/16
Q:1/4=240
K:C
% Two metallic tinks, the second softer, over a ringing metal noise: the armor holds.
%%hold on
%%bandlimit on
%%instrument tink wave=pulse amp=60 duty=10 attack=0 decay=35 sustain=0 release=50 gate=30 accents=marked fx=0
%%instrument ring wave=pulse amp=45 duty=40 attack=0 decay=140 sustain=0 release=160 gate=90 fx=0
%%instrument metal wave=noise amp=20 attack=0 decay=70 sustain=0 release=60 gate=40 noise=metal fx=0
%%effect 0 delay_steps=0 delay_feedback=0 delay_mix=0 drive=0 lowpass=0 mix=100
V:tink instrument=tink
| !f!b' !mp!b' z6 |
V:ring instrument=ring
| ^f' z7 |
V:metal instrument=metal
| b z7 |
