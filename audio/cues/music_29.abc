X:1
T:BRYX 29 Split wall
C:BRYX (audio/compose.py)
M:4/4
L:1/16
Q:1/4=138
K:C
% The Wall split by Ascent breaking through it, an octave above.
% mode E harmonic, progression cadence, form A(4) B(4) A2(4) break(2) turn(2)
% A=ascent_hi B=wall_hi counter=spark
%%hold on
%%master 47.1
%%loop on
%%bandlimit on
%%instrument kick wave=triangle amp=67 attack=0 decay=70 sustain=0 release=40 gate=60 pitch=24 pitch_time=55 fx=0
%%instrument snare wave=noise amp=22 attack=0 decay=60 sustain=0 release=70 gate=50 noise=long pitch=12 pitch_time=40 accents=marked fx=0
%%instrument hat wave=noise amp=10 attack=0 decay=12 sustain=0 release=14 gate=20 noise=metal accents=marked fx=0
%%instrument tom wave=triangle amp=40 attack=0 decay=140 sustain=0 release=60 gate=80 pitch=7 pitch_time=70 accents=marked fx=0
%%instrument bass wave=square amp=64 attack=1 decay=50 sustain=74 release=60 gate=78 fx=3
%%instrument arp wave=pulse amp=28 duty=22 attack=0 decay=24 sustain=50 release=40 gate=46 fx=2
%%instrument pad wave=pulse amp=15 duty=40 attack=60 decay=200 sustain=80 release=240 gate=98 accents=marked fx=3
%%instrument lead wave=square amp=24 attack=2 decay=90 sustain=74 release=140 gate=86 vibrato=5 vibrato_delay=120 accents=marked fx=1
%%instrument counter wave=pulse amp=16 duty=12 pwm=6 pwm_rate=400 attack=2 decay=100 sustain=60 release=160 gate=80 accents=marked fx=1
%%effect 0 delay_steps=0 delay_feedback=0 delay_mix=0 drive=26 lowpass=24 mix=100
%%effect 1 delay_steps=2 delay_feedback=30 delay_mix=22 drive=12 lowpass=30 mix=80
%%effect 2 mode=insert delay_steps=1 delay_feedback=20 delay_mix=14 drive=10 lowpass=36 sidechain=50 sidechain_release=140 sidechain_key=kick mix=100
%%effect 3 mode=insert delay_steps=0 delay_feedback=0 delay_mix=0 drive=30 lowpass=10 ladder=70 ladder_cutoff=34 ladder_resonance=58 mix=100
%%ramp bus3 ladder_cutoff 34 34 0 0
%%ramp bus1 delay_mix 22 22 0 0
%%ramp bus3 ladder_cutoff 34 62 64 127
%%ramp bus3 ladder_cutoff 34 34 128 128
%%ramp bus3 ladder_cutoff 34 14 192 223
%%ramp bus3 ladder_cutoff 14 34 224 239
%%ramp bus1 delay_mix 22 60 192 223
%%ramp bus1 delay_mix 22 22 224 224
%%ramp bus1 delay_mix 62 62 224 224
%%ramp bus1 delay_mix 22 22 240 240
