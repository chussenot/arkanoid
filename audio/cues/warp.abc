X:1
T:warp
C:BRYX
M:4/4
L:1/16
Q:1/4=240
K:C
% One note that rises three octaves, over a rising rush of noise, into an echoing room.
%%hold on
%%master 117.5
%%bandlimit on
%%instrument rise wave=pulse amp=60 duty=20 attack=10 decay=200 sustain=70 release=200 gate=95 pitch=-36 pitch_time=420 vibrato=20 fx=0
%%instrument air wave=noise amp=30 attack=120 decay=200 sustain=20 release=220 gate=90 noise=long pitch=-24 pitch_time=420 fx=0
%%effect 0 delay_steps=1 delay_feedback=40 delay_mix=30 drive=0 lowpass=30 reverb=18 reverb_size=70 reverb_damp=40 mix=100
V:rise instrument=rise
| e''2 z14 |
V:air instrument=air
| c'2 z14 |
