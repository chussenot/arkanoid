X:1
T:BRYX 28 Chevron
C:BRYX (audio/compose.py)
M:4/4
L:1/16
Q:1/4=138
K:C
% V-shape: Spark falls, then climbs back the same way.
% mode E aeolian, progression fall, form A(4) B(4) A2(4) break(2) turn(2)
% A=spark_fall B=spark_seq counter=ascent_inv
%%hold on
%%master 33.9
%%loop on
%%bandlimit on
%%instrument kick wave=triangle amp=67 attack=0 decay=70 sustain=0 release=40 gate=60 pitch=24 pitch_time=55 fx=0
%%instrument snare wave=noise amp=22 attack=0 decay=60 sustain=0 release=70 gate=50 noise=long pitch=12 pitch_time=40 accents=marked fx=0
%%instrument hat wave=noise amp=10 attack=0 decay=12 sustain=0 release=14 gate=20 noise=metal accents=marked fx=0
%%instrument tom wave=triangle amp=40 attack=0 decay=140 sustain=0 release=60 gate=80 pitch=7 pitch_time=70 accents=marked fx=0
%%instrument bass wave=pulse amp=46 duty=38 attack=1 decay=60 sustain=70 release=70 gate=80 fx=0
%%instrument arp wave=pulse amp=34 duty=14 attack=0 decay=30 sustain=40 release=50 gate=50 fx=2
%%instrument pad wave=triangle amp=7 attack=120 decay=200 sustain=80 release=300 gate=98 accents=marked fx=1
%%instrument lead wave=pulse amp=30 duty=25 pwm=10 pwm_rate=900 attack=4 decay=120 sustain=70 release=180 gate=88 vibrato=6 vibrato_delay=160 accents=marked fx=1
%%instrument counter wave=triangle amp=22 attack=8 decay=120 sustain=70 release=200 gate=86 accents=marked fx=1
%%effect 0 delay_steps=0 delay_feedback=0 delay_mix=0 drive=12 lowpass=20 mix=100
%%effect 1 delay_steps=3 delay_feedback=34 delay_mix=26 drive=0 lowpass=30 reverb=6 reverb_size=40 reverb_damp=55 mix=80
%%effect 2 mode=insert delay_steps=2 delay_feedback=24 delay_mix=18 drive=0 lowpass=40 sidechain=34 sidechain_release=160 sidechain_key=kick mix=100
%%effect 3 delay_steps=0 delay_feedback=0 delay_mix=0 drive=20 lowpass=20 mix=100
%%ramp bus1 delay_mix 26 26 0 0
%%ramp lead duty 25 25 0 0
%%ramp bus1 delay_mix 26 60 192 223
%%ramp bus1 delay_mix 26 26 224 224
%%ramp bus1 delay_mix 62 62 224 224
%%ramp bus1 delay_mix 26 26 240 240
%%ramp lead duty 25 12 128 191
%%ramp lead duty 25 25 192 192
