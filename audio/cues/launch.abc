X:1
T:launch
C:BRYX
M:4/4
L:1/16
Q:1/4=480
K:C
% One note that whips up two octaves into place, over a rising breath of noise.
%%hold on
%%master 121.8
%%bandlimit on
%%instrument whip wave=pulse amp=55 duty=30 attack=0 decay=40 sustain=40 release=40 gate=95 pitch=-24 pitch_time=55 fx=0
%%instrument breath wave=noise amp=14 attack=0 decay=50 sustain=0 release=40 gate=60 noise=long pitch=-12 pitch_time=55 fx=0
%%effect 0 delay_steps=0 delay_feedback=0 delay_mix=0 drive=0 lowpass=10 mix=100
V:whip instrument=whip
| e2 z6 |
V:breath instrument=breath
| c'2 z6 |
