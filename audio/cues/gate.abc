X:1
T:gate
C:BRYX
M:4/4
L:1/16
Q:1/4=300
K:C
% A grinding climb, then an open fifth that rings out: the wall gives way.
%%hold on
%%bandlimit on
%%instrument grind wave=pulse amp=40 duty=20 attack=0 decay=60 sustain=50 release=80 gate=85 glide=20 fx=0
%%instrument door wave=triangle amp=50 attack=5 decay=200 sustain=40 release=300 gate=95 fx=1
%%instrument rumble wave=noise amp=16 attack=20 decay=160 sustain=0 release=120 gate=80 noise=long fx=0
%%effect 0 delay_steps=0 delay_feedback=0 delay_mix=0 drive=6 lowpass=20 mix=100
%%effect 1 delay_steps=3 delay_feedback=30 delay_mix=30 drive=0 lowpass=20 reverb=20 reverb_size=70 reverb_damp=40 mix=80
V:grind instrument=grind
| E, B, E B z4 z8 |
V:door instrument=door
| z4 [eb]4 z8 |
V:rumble instrument=rumble
| E,4 z12 |
