X:1
T:paddle
C:BRYX
M:4/4
L:1/16
Q:1/4=240
K:C
% A triangle knock that drops a fourth onto its note, and a crisp clocked-noise click.
% The director raises it with the ball's speed, so it stays on E.
%%hold on
%%instrument body wave=triangle amp=85 attack=0 decay=70 sustain=0 release=60 gate=40 pitch=5 pitch_time=20 fx=0
%%instrument click wave=noise amp=30 attack=0 decay=8 sustain=0 release=6 gate=20 noise=long fx=0
%%effect 0 delay_steps=0 delay_feedback=0 delay_mix=0 drive=8 lowpass=30 mix=100
V:body instrument=body
| E, z7 |
V:click instrument=click
| c'' z7 |
